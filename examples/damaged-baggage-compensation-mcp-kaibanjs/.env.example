# Server Configuration
PORT=4001
NODE_ENV=development
LOG_LEVEL=info

# A2A Protocol Configuration
A2A_BASE_URL=http://localhost:4001

# Kaiban Platform Configuration
KAIBAN_TENANT=your-tenant
KAIBAN_ENVIRONMENT=dev
KAIBAN_API_TOKEN=your-kaiban-api-token
KAIBAN_API_URL=https://your-tenant.kaiban.io/api

# Kaiban MCP
KAIBAN_MCP_URL=https://your-tenant.kaiban.io/mcps/kaiban/mcp
KAIBAN_ENVIRONMENT=prod

# Damaged Baggage Compensation Agent
KAIBAN_AGENT_ID=your-baggage-compensation-agent-id
KAIBAN_DAMAGED_BAGGAGE_COMPENSATION_AGENT_ID=your-baggage-compensation-agent-id

# OpenAI API key for KaibanJS
OPENAI_API_KEY=your-openai-api-key

# Tavily API (real-time product price search, 1 call per product, max 5)
TAVILY_API_KEY=your-tavily-api-key
