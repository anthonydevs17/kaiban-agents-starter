{
  "name": "visit-planner-agent",
  "version": "0.1.0",
  "description": "Visit Planner Agent example using Mastra framework and OpenAI",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx --watch -r tsconfig-paths/register src/index.ts",
    "build": "tsc --noEmit",
    "start": "NODE_ENV=production tsx -r tsconfig-paths/register src/index.ts",
    "test": "vitest --run"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.4",
    "@ai-sdk/openai": "^2.0.53",
    "@kaiban/sdk": "^0.1.8",
    "@mastra/core": "^0.21.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pino": "^10.0.0",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.2",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.3"
  }
}
