{
  "name": "kaiban-a2a-agent-starter",
  "version": "0.1.0",
  "description": "Scaffold for building, publishing, and running Google A2A-protocol agents that connect to the Kaiban platform via kaiban-sdk.",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx --watch -r tsconfig-paths/register src/index.ts",
    "build": "tsc --noEmit",
    "start": "NODE_ENV=production tsx -r tsconfig-paths/register src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "refresh": "rm -rf node_modules package-lock.json && npm install",
    "test": "vitest --run"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "npm run lint:fix",
      "npm run format"
    ],
    "*.{json,md,yml,yaml}": [
      "npm run format"
    ]
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.4",
    "@kaiban/sdk": "^0.1.8",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pino": "^10.0.0",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.3"
  }
}
